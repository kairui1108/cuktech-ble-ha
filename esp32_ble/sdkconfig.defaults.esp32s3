# ESP32-S3 overrides — dual core, BLE 5.0 controller (same family as the C3).
# Everything else is shared in sdkconfig.defaults.

# Flash: keep in sync with the module actually fitted.  A 4 MB / DIO board
# needs FLASHSIZE_4MB and no QIO here, or the bootloader will probe modes the
# chip cannot do.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# IDF defaults the S3 to 160 MHz.  240 MHz cuts lwIP/TLS/JSON work per page
# request; the board is USB powered, so the extra draw costs nothing.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# CPU 1 runs the NimBLE host, CPU 0 runs WiFi/lwIP.
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y

# Watch the core-1 idle task as well as core 0 (dual-core only symbols).
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# One connection plus one scan: fewer controller activity slots leave more
# heap for WiFi RX/TX buffers during page loads (same reasoning as the C3).
CONFIG_BT_CTRL_BLE_MAX_ACT=2

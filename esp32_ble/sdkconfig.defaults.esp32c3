# ESP32-C3 overrides (single core, RISC-V).  Everything else is shared in
# sdkconfig.defaults.
CONFIG_FREERTOS_UNICORE=y
# One connection plus one scan: fewer controller activity slots leave more
# of the C3 heap for WiFi RX/TX buffers during page loads.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# Increase Interrupt WDT timeout (C3 single-core: BLE ISR + flash cache can
# delay interrupt exit, especially during GATT data bursts)
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000

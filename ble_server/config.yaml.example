# CUKTECH BLE Server Configuration
# Copy this file to config.yaml and fill in your values

ble:
  mac: "XX:XX:XX:XX:XX:XX"
  token: ""
  ble_key: ""
  scan_timeout: 15  # BLE 扫描超时（秒），弱信号环境可增大

mqtt:
  # 设置为 true 启用 MQTT（用于 Home Assistant 集成），false 则作为独立 web 服务运行
  # 也可以通过环境变量 MQTT_ENABLED=1 启用
  enabled: true
  host: "localhost"
  port: 1883
  username: ""
  password: ""
  keepalive: 60
  topic_prefix: "cuktech/charger"

server:
  host: "0.0.0.0"
  port: 8199       # Win 系统可能占用 8199 端口，改为 18199
  command_timeout: 10.0
  reconnect_base_delay: 1.0       # 初始重连延迟（秒）
  reconnect_max_delay: 300.0      # 最大重连延迟（秒）
  settings_refresh_interval: 10.0 # 端口状态刷新间隔（秒）
  log_level: "info"               # debug, info, warning, error
  history_retention_days: 2       # 保留最近 N 天的历史数据
  history_db_path: ""             # SQLite 数据库文件路径
  startup_stagger_sec: 2.0        # 多设备启动错峰（秒）：第 N 台等 N×该值。单设备恒 0 延迟

# ── 附加设备（可选，Beta）─────────────────────────────────────────────────────
# 多设备能力在『两台真机 canary 通过』前标 Beta：单设备路径有逐字节快照锁定，
# 多台真机并发认证/互相干扰尚待硬件验证（见 README 的多设备一节）。
# 不写这一节 = 单设备，行为与以前 100% 一致（含 MQTT 主题、HTTP 接口、SSE）。
# 写了以后每台设备有独立的状态/会话/限额/历史，互不干扰；
# `ble:` 节永远是 primary（device_id 固定为 default，不可删除）。
#
# devices:
#   - id: desk                     # 必填。topic 后缀兼设备标识（小写字母/数字/_-）
#     name: "书桌充电器"            # 可选，界面显示名；缺省用 id
#     mac: "AA:BB:CC:DD:EE:02"     # 必填，全局唯一（跨节）
#     token: "00112233..."         # 必填，32 位 hex（与 ble.token 同格式）
#     ble_key: ""                  # 可选
#     topic_prefix: ""             # 可选。空 = 自动 "{mqtt.topic_prefix}/{id}"

bemfa:
  enabled: false   # 是否启用巴法云，接入小爱同学/小度音箱
  uid: ""          # 巴法云控制台的私钥
  name_c1: "C口1开关"       # 巴法云设备显示名称（可自定义）
  name_c2: "C口2开关"
  name_c3: "C口3开关"
  name_a: "USB-A开关"
  name_ble: "蓝牙开关"
  # 语音实体给哪些设备建模（设备 id 列表）：缺省只有 primary，避免设备多时实体爆炸。
  # 写成 ["*"] 表示所有设备；非 primary 的实体 id 会加 `{device_id}_` 前缀。
  allowed_devices: ["default"]
